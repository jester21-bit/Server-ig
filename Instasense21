  <!-- SCRIPT LOGIKA ANALISIS MURNI (TANPA DEMO/SIMULASI) -->
  <script>
    // State Aplikasi
    let currentComments = [];
    let activeFilter = 'ALL';
    let searchQuery = '';
    let donutChartInstance = null;
    let aspectChartInstance = null;

    // Default Endpoint API
    const DEFAULT_ENDPOINT = 'http://localhost:8000/api/scrape-comments';
    function getApiEndpoint() {
      return localStorage.getItem('instasense_endpoint') || DEFAULT_ENDPOINT;
    }

    // Kamus Sentimen Bahasa Indonesia & Slang Instagram
    const DICT = {
      positive: [
        'bagus', 'keren', 'mantap', 'suka', 'love', 'kece', 'adem', 'rapi', 'puas', 
        'original', 'ori', 'cepat', 'amanah', 'recommended', 'recomended', 'worth', 'worthit',
        'terbaik', 'top', 'lucu', 'cantik', 'ganteng', 'ramah', 'gercep', 'enak', 'terjangkau',
        'murah', 'gokil', 'epic', 'berkualitas', 'mewah', 'aesthetic', 'estetik', 'the best'
      ],
      negative: [
        'jelek', 'kecewa', 'rusak', 'patah', 'cacat', 'bapuk', 'zonk', 'lambat', 'lelet',
        'lama', 'mahal', 'rugi', 'menyesal', 'tipu', 'parah', 'buruk', 'kasar', 'panas',
        'sobek', 'bengkok', 'salah', 'kurang', 'pecah', 'nyesel', 'payah', 'kapok'
      ],
      negations: ['tidak', 'gak', 'nggak', 'ga', 'bukan', 'kurang', 'jangan'],
      boosters: ['banget', 'bgt', 'sekali', 'parah', 'super', 'amat', 'beneran', 'bener-bener']
    };

    // Kamus Aspek/Topik
    const TOPICS = {
      Kualitas: ['bahan', 'kain', 'kualitas', 'rusak', 'awet', 'cacat', 'jahitan', 'tebal', 'tipis', 'adem', 'panas', 'ori', 'original'],
      Pelayanan: ['admin', 'respon', 'pelayanan', 'seller', 'ramah', 'cs', 'chat', 'tanya', 'balas'],
      Harga: ['harga', 'murah', 'mahal', 'worth', 'diskon', 'promo', 'ongkir', 'biaya'],
      Pengiriman: ['kirim', 'kurir', 'pengiriman', 'sampai', 'lama', 'lambat', 'cepat', 'ekspedisi', 'packing'],
      Desain: ['model', 'warna', 'desain', 'motif', 'ukuran', 'size', 'bentuk', 'style', 'estetik', 'kece']
    };

    // Evaluasi Sentimen Per Komentar
    function evaluateCommentSentiment(text) {
      if (!text) return { polarity: 'NEUTRAL', score: 0, matchedWords: [], topics: ['Umum'] };

      const cleanText = text.toLowerCase();
      const words = cleanText.replace(/[^a-zA-Z0-9\s]/g, ' ').split(/\s+/).filter(Boolean);
      
      let score = 0;
      let matchedWords = [];

      for (let i = 0; i < words.length; i++) {
        const w = words[i];
        const isNegated = i > 0 && DICT.negations.includes(words[i - 1]);
        const isBoosted = (i > 0 && DICT.boosters.includes(words[i - 1])) || (i < words.length - 1 && DICT.boosters.includes(words[i + 1]));
        const multiplier = (isBoosted ? 1.5 : 1.0) * (isNegated ? -1 : 1);

        if (DICT.positive.includes(w)) {
          score += (1 * multiplier);
          matchedWords.push({ word: w, type: multiplier > 0 ? 'pos' : 'neg' });
        } else if (DICT.negative.includes(w)) {
          score -= (1 * multiplier);
          matchedWords.push({ word: w, type: multiplier > 0 ? 'neg' : 'pos' });
        }
      }

      // Deteksi Topik
      const assignedTopics = [];
      for (const [topicName, keywords] of Object.entries(TOPICS)) {
        if (keywords.some(k => cleanText.includes(k))) {
          assignedTopics.push(topicName);
        }
      }
      if (assignedTopics.length === 0) assignedTopics.push('Umum');

      let polarity = 'NEUTRAL';
      if (score >= 0.75) polarity = 'POSITIVE';
      else if (score <= -0.75) polarity = 'NEGATIVE';

      return { polarity, score, matchedWords, topics: assignedTopics };
    }

    // Submit Handler Penarikan Data Asli
    async function handleScrape(e) {
      e.preventDefault();
      const urlInput = document.getElementById('igUrlInput');
      const limitSelect = document.getElementById('limitSelect');
      const btn = document.getElementById('btnScrape');
      const targetUrl = urlInput.value.trim();
      const limitVal = parseInt(limitSelect.value) || 50;

      if (!targetUrl) return;

      // Ubah UI ke status Loading
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> <span>Mengambil data...</span>';
      dismissStatusAlert();

      const endpoint = getApiEndpoint();

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            url: targetUrl,
            max_comments: limitVal
          })
        });

        if (!response.ok) {
          const errData = await response.json().catch(() => ({}));
          throw new Error(errData.detail || `Server error (${response.status})`);
        }

        const data = await response.json();
        
        if (!data.comments || data.comments.length === 0) {
          throw new Error("Postingan ditemukan, tetapi tidak ada komentar publik yang berhasil ditarik.");
        }

        // Tampilkan Banner Metadata Postingan
        document.getElementById('lblShortcode').textContent = data.shortcode || '-';
        document.getElementById('lblOwner').textContent = data.owner_username ? `@${data.owner_username}` : 'Publik';
        document.getElementById('lblCount').textContent = data.comments.length;
        document.getElementById('targetMetaBar').classList.remove('hidden');

        // Analisis Teks Komentar Nyata
        processRealComments(data.comments);

        showStatusAlert(
          'success', 
          `Berhasil mengambil dan menganalisis <strong>${data.comments.length} komentar nyata</strong> dari postingan Instagram.`
        );

      } catch (err) {
        console.error("Scrape Error:", err);
        
        // Tampilkan pesan error murni, tanpa beralih ke simulasi/demo
        showStatusAlert(
          'error',
          `<strong>Gagal Menarik Data:</strong> ${err.message}<br>
          <span class="text-xs text-rose-200 mt-1 block">
            Pastikan: (1) Server backend FastAPI Anda sedang berjalan di <code>${endpoint}</code>, 
            (2) Postingan bersifat publik, dan (3) URL postingan valid.
          </span>`
        );
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fa-solid fa-magnifying-glass-chart"></i> <span>Ambil & Analisis</span>';
      }
    }

    // Memproses Data Komentar Asli
    function processRealComments(rawCommentsList) {
      currentComments = rawCommentsList.map((item, idx) => {
        const text = typeof item === 'string' ? item : (item.text || '');
        const author = typeof item === 'object' && item.author ? item.author : `user_${idx + 1}`;
        const analysis = evaluateCommentSentiment(text);

        return {
          id: idx + 1,
          author: author,
          text: text,
          likes: item.likes || 0,
          polarity: analysis.polarity,
          score: analysis.score,
          topics: analysis.topics,
          matchedWords: analysis.matchedWords
        };
      });

      // Sembunyikan Empty State, Tampilkan Dashboard
      document.getElementById('emptyState').classList.add('hidden');
      document.getElementById('dashboardView').classList.remove('hidden');

      // Refresh seluruh widget analitik
      updateKPICards();
      renderDonutChart();
      renderAspectChart();
      renderKeywordCloud();
      renderCommentsTable();
    }

    // Hitung & Tampilkan KPI
    function updateKPICards() {
      const total = currentComments.length;
      if (total === 0) return;

      const posCount = currentComments.filter(c => c.polarity === 'POSITIVE').length;
      const neuCount = currentComments.filter(c => c.polarity === 'NEUTRAL').length;
      const negCount = currentComments.filter(c => c.polarity === 'NEGATIVE').length;

      const posPct = ((posCount / total) * 100).toFixed(1);
      const neuPct = ((neuCount / total) * 100).toFixed(1);
      const negPct = ((negCount / total) * 100).toFixed(1);

      // NSS = ((Positif - Negatif) / Total) * 100
      const nss = Math.round(((posCount - negCount) / total) * 100);

      document.getElementById('kpiNssVal').textContent = (nss > 0 ? `+${nss}` : nss);
      document.getElementById('kpiPosVal').textContent = posCount;
      document.getElementById('kpiPosPct').textContent = `${posPct}%`;
      document.getElementById('kpiNeuVal').textContent = neuCount;
      document.getElementById('kpiNeuPct').textContent = `${neuPct}%`;
      document.getElementById('kpiNegVal').textContent = negCount;
      document.getElementById('kpiNegPct').textContent = `${negPct}%`;

      const nssLabelEl = document.getElementById('kpiNssLabel');
      if (nss >= 40) {
        nssLabelEl.className = 'mt-2 text-xs font-semibold text-emerald-400';
        nssLabelEl.textContent = 'Apresiasi Sangat Kuat';
      } else if (nss >= 0) {
        nssLabelEl.className = 'mt-2 text-xs font-semibold text-amber-400';
        nssLabelEl.textContent = 'Sentimen Cukup Berimbang';
      } else {
        nssLabelEl.className = 'mt-2 text-xs font-semibold text-rose-400';
        nssLabelEl.textContent = 'Perlu Evaluasi Keluhan';
      }
    }

    // Donut Chart
    function renderDonutChart() {
      const ctx = document.getElementById('donutChart').getContext('2d');
      const posCount = currentComments.filter(c => c.polarity === 'POSITIVE').length;
      const neuCount = currentComments.filter(c => c.polarity === 'NEUTRAL').length;
      const negCount = currentComments.filter(c => c.polarity === 'NEGATIVE').length;

      if (donutChartInstance) donutChartInstance.destroy();

      donutChartInstance = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Positif', 'Netral', 'Negatif'],
          datasets: [{
            data: [posCount, neuCount, negCount],
            backgroundColor: ['#10b981', '#f59e0b', '#f43f5e'],
            borderWidth: 2,
            borderColor: '#0b0f19'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          cutout: '70%'
        }
      });
    }

    // Aspect Bar Chart
    function renderAspectChart() {
      const ctx = document.getElementById('aspectChart').getContext('2d');
      const aspectNames = Object.keys(TOPICS);

      const posData = [];
      const negData = [];

      aspectNames.forEach(asp => {
        const related = currentComments.filter(c => c.topics.includes(asp));
        posData.push(related.filter(c => c.polarity === 'POSITIVE').length);
        negData.push(related.filter(c => c.polarity === 'NEGATIVE').length);
      });

      if (aspectChartInstance) aspectChartInstance.destroy();

      aspectChartInstance = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: aspectNames,
          datasets: [
            { label: 'Positif', data: posData, backgroundColor: '#10b981', borderRadius: 4 },
            { label: 'Negatif', data: negData, backgroundColor: '#f43f5e', borderRadius: 4 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          scales: {
            x: { grid: { display: false }, ticks: { color: '#94a3b8', font: { size: 11 } } },
            y: { grid: { color: 'rgba(255,255,255,0.05)' }, ticks: { color: '#94a3b8', font: { size: 10 }, stepSize: 1 } }
          },
          plugins: { legend: { labels: { color: '#cbd5e1', font: { size: 11 } } } }
        }
      });
    }

    // Pill Cloud Kata Kunci
    function renderKeywordCloud() {
      const posMap = {};
      const negMap = {};

      currentComments.forEach(c => {
        c.matchedWords.forEach(m => {
          if (m.type === 'pos') posMap[m.word] = (posMap[m.word] || 0) + 1;
          else if (m.type === 'neg') negMap[m.word] = (negMap[m.word] || 0) + 1;
        });
      });

      const posContainer = document.getElementById('posKeywordCloud');
      const negContainer = document.getElementById('negKeywordCloud');

      const topPos = Object.entries(posMap).sort((a,b) => b[1] - a[1]).slice(0, 8);
      const topNeg = Object.entries(negMap).sort((a,b) => b[1] - a[1]).slice(0, 8);

      posContainer.innerHTML = topPos.length > 0 
        ? topPos.map(([w, cnt]) => `<span class="px-2 py-1 rounded-md bg-emerald-500/10 text-emerald-300 border border-emerald-500/20">${w} <strong class="text-[10px] opacity-75">(${cnt})</strong></span>`).join('')
        : '<span class="text-slate-500 italic text-[11px]">Tidak ada kata dominan</span>';

      negContainer.innerHTML = topNeg.length > 0
        ? topNeg.map(([w, cnt]) => `<span class="px-2 py-1 rounded-md bg-rose-500/10 text-rose-300 border border-rose-500/20">${w} <strong class="text-[10px] opacity-75">(${cnt})</strong></span>`).join('')
        : '<span class="text-slate-500 italic text-[11px]">Tidak ada keluhan dominan</span>';
    }

    // Render Tabel Feed
    function renderCommentsTable() {
      const tbody = document.getElementById('commentTableBody');
      tbody.innerHTML = '';

      let filtered = currentComments;

      if (activeFilter !== 'ALL') {
        filtered = filtered.filter(c => c.polarity === activeFilter);
      }

      if (searchQuery) {
        filtered = filtered.filter(c => c.text.toLowerCase().includes(searchQuery.toLowerCase()) || c.author.toLowerCase().includes(searchQuery.toLowerCase()));
      }

      if (filtered.length === 0) {
        tbody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-slate-500 italic">Tidak ada komentar yang cocok dengan filter.</td></tr>`;
        return;
      }

      filtered.forEach((c, idx) => {
        let badge = '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30">Netral</span>';
        if (c.polarity === 'POSITIVE') badge = '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">Positif</span>';
        if (c.polarity === 'NEGATIVE') badge = '<span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-rose-500/20 text-rose-300 border border-rose-500/30">Negatif</span>';

        const row = document.createElement('tr');
        row.className = "hover:bg-slate-800/40 transition";
        row.innerHTML = `
          <td class="px-3.5 py-2.5 text-slate-500">${idx + 1}</td>
          <td class="px-3.5 py-2.5 font-medium text-slate-200">@${escapeHtml(c.author)}</td>
          <td class="px-3.5 py-2.5 text-slate-300">${highlightWords(escapeHtml(c.text), c.matchedWords)}</td>
          <td class="px-3.5 py-2.5 text-slate-400 text-[11px]">${c.topics.join(', ')}</td>
          <td class="px-3.5 py-2.5 text-center">${badge}</td>
        `;
        tbody.appendChild(row);
      });
    }

    // Penanda Kata Pemicu Sentimen
    function highlightWords(text, matches) {
      if (!matches || matches.length === 0) return text;
      let res = text;
      matches.forEach(m => {
        const regex = new RegExp(`\\b(${m.word})\\b`, 'gi');
        const colorClass = m.type === 'pos' ? 'text-emerald-300 font-semibold underline' : 'text-rose-300 font-semibold underline';
        res = res.replace(regex, `<span class="${colorClass}">$1</span>`);
      });
      return res;
    }

    // Filter & Search Controls
    function setFilter(type) {
      activeFilter = type;
      ['ALL', 'POSITIVE', 'NEUTRAL', 'NEGATIVE'].forEach(t => {
        const btn = document.getElementById(t === 'ALL' ? 'fltAll' : t === 'POSITIVE' ? 'fltPos' : t === 'NEUTRAL' ? 'fltNeu' : 'fltNeg');
        if (t === type) {
          btn.className = "px-2.5 py-1 rounded-md bg-slate-800 text-white font-medium";
        } else {
          btn.className = "px-2.5 py-1 rounded-md text-slate-400 hover:text-white font-medium";
        }
      });
      renderCommentsTable();
    }

    function handleSearchComment(e) {
      searchQuery = e.target.value;
      renderCommentsTable();
    }

    // Ekspor Data ke Format CSV
    function exportToCsv() {
      if (currentComments.length === 0) return;
      let csv = "ID,Username,Komentar,Topik,Sentimen\n";
      currentComments.forEach(c => {
        const cleanText = c.text.replace(/"/g, '""');
        csv += `${c.id},"${c.author}","${cleanText}","${c.topics.join(';')}",${c.polarity}\n`;
      });
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.setAttribute("href", url);
      link.setAttribute("download", `Instagram_Sentiment_${Date.now()}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    }

    // Helper Modal Pengaturan
    function openConfigModal() {
      document.getElementById('endpointInput').value = getApiEndpoint();
      document.getElementById('configModal').classList.remove('hidden');
    }
    function closeConfigModal() {
      document.getElementById('configModal').classList.add('hidden');
    }
    function saveConfigModal() {
      const val = document.getElementById('endpointInput').value.trim();
      if (val) localStorage.setItem('instasense_endpoint', val);
      closeConfigModal();
      showStatusAlert('info', `Endpoint berhasil diperbarui ke: <code>${getApiEndpoint()}</code>`);
    }

    // Status Alert UI
    function showStatusAlert(type, htmlMsg) {
      const box = document.getElementById('statusAlert');
      const icon = document.getElementById('statusIcon');
      const msg = document.getElementById('statusMessage');

      box.classList.remove('hidden', 'bg-rose-500/10', 'border-rose-500/30', 'text-rose-200', 'bg-emerald-500/10', 'border-emerald-500/30', 'text-emerald-200', 'bg-blue-500/10', 'border-blue-500/30', 'text-blue-200');

      if (type === 'error') {
        box.classList.add('bg-rose-500/10', 'border', 'border-rose-500/30', 'text-rose-200');
        icon.className = 'fa-solid fa-triangle-exclamation text-rose-400 mt-0.5';
      } else if (type === 'success') {
        box.classList.add('bg-emerald-500/10', 'border', 'border-emerald-500/30', 'text-emerald-200');
        icon.className = 'fa-solid fa-circle-check text-emerald-400 mt-0.5';
      } else {
        box.classList.add('bg-blue-500/10', 'border', 'border-blue-500/30', 'text-blue-200');
        icon.className = 'fa-solid fa-circle-info text-blue-400 mt-0.5';
      }

      msg.innerHTML = htmlMsg;
    }
    function dismissStatusAlert() {
      document.getElementById('statusAlert').classList.add('hidden');
    }

    function escapeHtml(text) {
      return text.replace(/[&<>"']/g, function(m) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m];
      });
    }
  </script>
